{
  "manifest_version": 3,
  "name": "atelier",
  "version": "0.0.0",
  "description": "Agent-authored userstyles.",
  "browser_specific_settings": {
    "gecko": { "id": "__GECKO_ID__", "strict_min_version": "140.0" }
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "atelier" },
  "permissions": ["nativeMessaging", "storage", "webNavigation", "alarms"],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"]
}
